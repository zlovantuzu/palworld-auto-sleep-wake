[Unit]
Description=Palworld Dedicated Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@PALWORLD_USER@
Group=@PALWORLD_GROUP@
Environment=PALWORLD_AUTO_CONFIG=/etc/palworld-auto/config
ExecStart=/usr/local/lib/palworld-auto/palworld-run

KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=180
Restart=no

LimitNOFILE=100000
UMask=0027

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
